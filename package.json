{
  "name": "modakbul-season1-launcher",
  "version": "1.0.11",
  "productName": "모닥불 Season 1",
  "description": "모닥불 Season 1 전용 Minecraft 런처",
  "author": "모닥불 Season 1 운영팀",
  "license": "MIT",
  "homepage": "https://github.com/GTYoon/modakbul-launcher",
  "bugs": {
    "url": "https://github.com/GTYoon/modakbul-launcher/issues"
  },
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "dist": "node tools/build-electron.js",
    "dist:win": "npm run dist -- -w",
    "dist:mac": "npm run dist -- -m",
    "dist:linux": "npm run dist -- -l",
    "lint": "eslint .",
    "test:auth-race": "node tools/Test-AuthValidationRace.js",
    "verify:play-fix": "node tools/Verify-PlayFix.js",
    "verify:built": "node tools/Verify-BuiltLauncher.js && node tools/Verify-PlayFix.js"
  },
  "engines": {
    "node": "22.x.x"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "adm-zip": "^0.5.16",
    "discord-rpc-patch": "^4.0.1",
    "ejs": "^3.1.10",
    "ejs-electron": "^3.0.0",
    "electron-updater": "^6.7.3",
    "fs-extra": "^11.3.3",
    "github-syntax-dark": "^0.5.0",
    "got": "^11.8.5",
    "helios-core": "~2.3.0",
    "helios-distribution-types": "^1.3.0",
    "jquery": "^3.7.1",
    "lodash.merge": "^4.6.2",
    "semver": "^7.7.3",
    "toml": "^3.0.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.6.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.2",
    "rcedit": "5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GTYoon/modakbul-launcher.git"
  }
}
